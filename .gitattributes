# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary
*.ico      binary
*.svg      text
*.woff     binary
*.woff2    binary

# Linguist: treat these as documentation
*.md       linguist-documentation
